#!/usr/bin/env sh
set -e

if ! command -v gitleaks >/dev/null 2>&1; then
	echo "gitleaks is required for the pre-commit secret scan."
	echo "Install it with: brew install gitleaks"
	echo "Other install options: https://github.com/gitleaks/gitleaks#installing"
	exit 1
fi

gitleaks git --pre-commit --redact --staged --verbose

# Read-only staged checks: Biome in check-only mode plus a generated-proto
# freshness check. The hook never rewrites staged files, never re-stages
# anything, and never touches the git index -- see scripts/check-staged.mjs.
cd apps/vscode && node scripts/check-staged.mjs

